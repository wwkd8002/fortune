<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>สมุดบันทึกรายได้ดูดวง</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔮</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Mitr:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #FBF5EC;
    --card: #FFFEFB;
    --brown-900: #3E2A1E;
    --brown-800: #4A3427;
    --brown-700: #6B4A32;
    --brown-500: #9C7350;
    --brown-300: #D9BFA0;
    --brown-200: #EBDCC6;
    --brown-100: #F4EAD9;
    --accent: #B5651D;
    --accent-dark: #8F4E14;
    --accent-soft: #F0DCC0;
    --bonus: #C08A2E;
    --bonus-bg: #FBEFD3;
    --shadow: 0 4px 16px rgba(74, 52, 39, 0.08);
    --shadow-soft: 0 2px 8px rgba(74, 52, 39, 0.06);
    --radius-lg: 20px;
    --radius-md: 14px;
    --radius-sm: 10px;
  }

  *{ box-sizing: border-box; }

  body{
    margin:0;
    background: var(--bg);
    background-image:
      radial-gradient(circle at 8% 8%, rgba(181,101,29,0.06) 0, transparent 40%),
      radial-gradient(circle at 95% 15%, rgba(181,101,29,0.05) 0, transparent 35%);
    color: var(--brown-800);
    font-family: 'Noto Sans Thai', sans-serif;
    min-height: 100vh;
    padding-bottom: 60px;
  }

  h1, h2, h3, .display{
    font-family: 'Mitr', 'Noto Sans Thai', sans-serif;
  }

  ::selection{ background: var(--accent-soft); }

  /* Header */
  header{
    padding: 32px 24px 20px;
    max-width: 1180px;
    margin: 0 auto;
    text-align: center;
    position: relative;
  }

  .crescent{
    font-size: 26px;
    letter-spacing: 10px;
    opacity: .55;
    margin-bottom: 4px;
  }

  header h1{
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 700;
    color: var(--brown-900);
    margin: 0 0 6px;
  }

  header p.sub{
    margin:0;
    color: var(--brown-500);
    font-size: 14px;
  }

  /* Month nav */
  .month-nav{
    display:flex;
    align-items:center;
    justify-content:center;
    gap: 14px;
    margin: 22px auto 0;
  }

  .nav-btn{
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--brown-300);
    background: var(--card);
    color: var(--brown-700);
    font-size: 18px;
    cursor: pointer;
    display:flex; align-items:center; justify-content:center;
    transition: all .15s ease;
    box-shadow: var(--shadow-soft);
  }
  .nav-btn:hover:not(:disabled){ background: var(--accent-soft); border-color: var(--accent); color: var(--accent-dark); transform: translateY(-1px); }
  .nav-btn:disabled{ opacity: .3; cursor: not-allowed; }

  .month-label{
    font-family:'Mitr', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--brown-900);
    min-width: 220px;
    text-align: center;
  }

  .today-btn{
    border: none;
    background: transparent;
    color: var(--accent-dark);
    font-family:'Noto Sans Thai';
    font-size: 13px;
    text-decoration: underline;
    cursor: pointer;
    margin-left: 6px;
  }

  /* Container */
  main{
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Summary cards */
  .summary-grid{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 14px;
    margin: 28px 0;
  }

  .card{
    background: var(--card);
    border-radius: var(--radius-md);
    padding: 18px 20px;
    box-shadow: var(--shadow);
    border: 1px solid var(--brown-100);
  }

  .card .label{
    font-size: 12.5px;
    color: var(--brown-500);
    margin-bottom: 6px;
    display:flex; align-items:center; gap:6px;
  }

  .card .value{
    font-family:'Mitr', sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: var(--brown-900);
  }

  .card.accent{
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
    border: none;
  }
  .card.accent .label{ color: rgba(255,255,255,0.85); }
  .card.accent .value{ color: #fff; }

  /* Toolbar */
  .toolbar{
    display:flex;
    justify-content: flex-end;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .btn{
    border: 1px solid var(--brown-300);
    background: var(--card);
    color: var(--brown-700);
    padding: 8px 16px;
    border-radius: 999px;
    font-family:'Noto Sans Thai';
    font-size: 13px;
    cursor: pointer;
    transition: all .15s ease;
  }
  .btn:hover{ background: var(--brown-100); }
  .btn.danger{ color: #a44; border-color: #e0c4c4; }
  .btn.danger:hover{ background: #fbeeee; }
  #importFile{ display:none; }

  /* Calendar */
  .calendar-wrap{
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 18px;
    overflow-x: auto;
    border: 1px solid var(--brown-100);
  }

  .weekday-row, .week-row{
    display: grid;
    grid-template-columns: repeat(7, minmax(132px, 1fr));
    gap: 8px;
    min-width: 940px;
  }

  .weekday-row{
    margin-bottom: 10px;
  }

  .weekday-row div{
    text-align:center;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--brown-500);
    padding-bottom: 4px;
  }

  .week-block{ margin-bottom: 10px; }

  .day-cell{
    background: var(--brown-100);
    border-radius: var(--radius-sm);
    padding: 10px;
    display:flex;
    flex-direction: column;
    gap: 6px;
    min-height: 168px;
    position: relative;
    border: 1px solid transparent;
    transition: border-color .15s ease;
  }

  .day-cell.current-month{ background: #FFFDF9; border-color: var(--brown-200); }
  .day-cell.pad{ opacity: .45; }
  .day-cell.today{ border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft) inset; }
  .day-cell.has-bonus{ background: var(--bonus-bg); border-color: #ecd8a0; }

  .day-num{
    font-family:'Mitr', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--brown-700);
  }

  .field{
    display:flex;
    align-items:center;
    justify-content: space-between;
    gap: 6px;
  }

  .field label{
    font-size: 11px;
    color: var(--brown-500);
    flex-shrink: 0;
  }

  .field input{
    width: 100%;
    max-width: 56px;
    border: 1px solid var(--brown-300);
    border-radius: 7px;
    padding: 3px 6px;
    font-size: 12.5px;
    text-align: right;
    font-family: 'Noto Sans Thai';
    background: #fff;
    color: var(--brown-900);
  }
  .field input:disabled{
    background: transparent;
    border-color: transparent;
    color: var(--brown-500);
  }
  .field input:focus{
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-soft);
  }

  .day-total{
    margin-top: auto;
    font-family:'Mitr', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: var(--brown-900);
    border-top: 1px dashed var(--brown-300);
    padding-top: 6px;
  }

  .bonus-note{
    font-size: 10.5px;
    color: var(--bonus);
    font-weight: 600;
  }

  .week-summary{
    display:flex;
    justify-content: flex-end;
    gap: 22px;
    font-size: 12.5px;
    color: var(--brown-500);
    padding: 6px 6px 2px;
  }
  .week-summary b{ color: var(--brown-800); }
  .week-summary .net{ color: var(--accent-dark); }

  footer{
    max-width: 1180px;
    margin: 30px auto 0;
    padding: 0 24px;
    text-align: center;
    color: var(--brown-500);
    font-size: 12px;
    line-height: 1.7;
  }
  footer .icon-row{ opacity:.5; font-size:14px; letter-spacing:6px; margin-bottom:6px; }

  @media (max-width: 640px){
    header{ padding: 24px 16px 12px; }
    main{ padding: 0 16px; }
    .month-label{ min-width: 150px; font-size: 17px; }
  }
</style>
</head>
<body>

<header>
  <div class="crescent">☾ ⋆ ✧ ⋆ ☽</div>
  <h1>สมุดบันทึกรายได้ดูดวง 🔮</h1>
  <p class="sub">บันทึกส่วนตัว · เก็บข้อมูลไว้ในเบราว์เซอร์นี้เท่านั้น</p>

  <div class="month-nav">
    <button class="nav-btn" id="prevBtn" aria-label="เดือนก่อนหน้า">‹</button>
    <div class="month-label" id="monthLabel">สิงหาคม 2026</div>
    <button class="nav-btn" id="nextBtn" aria-label="เดือนถัดไป">›</button>
  </div>
  <button class="today-btn" id="todayBtn">ไปเดือนปัจจุบัน</button>
</header>

<main>

  <div class="summary-grid">
    <div class="card accent">
      <div class="label">✨ รายรับรวมเดือนนี้ (ก่อนหักภาษี)</div>
      <div class="value" id="sumGross">0 ฿</div>
    </div>
    <div class="card">
      <div class="label">💰 รายรับสุทธิเดือนนี้ (หลังหัก 3%)</div>
      <div class="value" id="sumNet">0 ฿</div>
    </div>
    <div class="card">
      <div class="label">🔢 จำนวนครั้งรวม (ปกติ/ด่วน/ร้อนใจ)</div>
      <div class="value" id="sumCount">0</div>
    </div>
    <div class="card">
      <div class="label">🎉 วันที่ได้โบนัส</div>
      <div class="value" id="sumBonus">0 วัน</div>
    </div>
  </div>

  <div class="toolbar">
    <button class="btn" id="exportBtn">⬇ ส่งออกข้อมูล (JSON)</button>
    <button class="btn" id="importBtn">⬆ นำเข้าข้อมูล</button>
    <input type="file" id="importFile" accept="application/json">
    <button class="btn danger" id="clearBtn">ล้างข้อมูลทั้งหมด</button>
  </div>

  <div class="calendar-wrap">
    <div class="weekday-row">
      <div>อา.</div><div>จ.</div><div>อ.</div><div>พ.</div><div>พฤ.</div><div>ศ.</div><div>ส.</div>
    </div>
    <div id="weeksContainer"></div>
  </div>

</main>

<footer>
  <div class="icon-row">✦ ⁺ ˚ 🔮 ˚ ⁺ ✦</div>
  <p>
    ปกติ 1 ครั้ง = 10 ฿ · ด่วน 1 ครั้ง = 20 ฿ · ร้อนใจ 1 ครั้ง = 40 ฿ · ทุกๆ 100 ครั้งของช่อง "ปกติ" ในวันนั้น จะได้โบนัสอัตโนมัติ +100 ฿ (เช่น 200 ครั้ง = โบนัส 200 ฿)<br>
    ยอดรายสัปดาห์ (อา.–ส.) จะถูกหักภาษี ณ ที่จ่าย 3% โดยอัตโนมัติ ก่อนรวมเป็นยอดสุทธิรายเดือน<br>
    ข้อมูลทั้งหมดถูกบันทึกไว้ใน localStorage ของเบราว์เซอร์นี้เท่านั้น กรุณากด "ส่งออกข้อมูล" เป็นประจำเพื่อสำรองไฟล์ไว้กันข้อมูลหาย
  </p>
</footer>

<script>
(function(){
  "use strict";

  var STORAGE_KEY = "duangDiaryData_v1";
  var START_YEAR = 2026, START_MONTH = 7; // August 2026 (0-indexed)

  var RATE = { n: 10, u: 20, h: 40 };
  var BONUS_THRESHOLD = 100;
  var BONUS_AMOUNT = 100;
  var TAX_RATE = 0.97; // withheld 3%

  var THAI_MONTHS = ["มกราคม","กุมภาพันธ์","มีนาคม","เมษายน","พฤษภาคม","มิถุนายน",
    "กรกฎาคม","สิงหาคม","กันยายน","ตุลาคม","พฤศจิกายน","ธันวาคม"];

  var data = loadData();
  var now = new Date();
  var view = { year: START_YEAR, month: START_MONTH };

  // If current real date is after start month, open on current month by default
  if (now.getFullYear() > START_YEAR || (now.getFullYear() === START_YEAR && now.getMonth() >= START_MONTH)) {
    view.year = now.getFullYear();
    view.month = now.getMonth();
  }

  function loadData(){
    try{
      var raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    }catch(e){ return {}; }
  }

  function saveData(){
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  }

  function pad2(x){ return x < 10 ? "0"+x : ""+x; }

  function dateKey(y, m, d){
    return y + "-" + pad2(m+1) + "-" + pad2(d);
  }

  function getEntry(key){
    return data[key] || { n:0, u:0, h:0 };
  }

  function calcDay(entry){
    var base = entry.n*RATE.n + entry.u*RATE.u + entry.h*RATE.h;
    var bonusUnits = Math.floor(entry.n / BONUS_THRESHOLD);
    var bonus = bonusUnits * BONUS_AMOUNT;
    return { base: base, bonus: bonus, total: base + bonus };
  }

  function fmt(n){
    var rounded = Math.round(n * 100) / 100; // avoid floating point noise, keep up to 2 decimals
    return rounded.toLocaleString('th-TH', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + " ฿";
  }

  function isBeforeStart(y, m){
    return (y < START_YEAR) || (y === START_YEAR && m < START_MONTH);
  }

  function render(){
    document.getElementById("monthLabel").textContent = THAI_MONTHS[view.month] + " " + (view.year + 543);

    var prevMonth = view.month - 1, prevYear = view.year;
    if (prevMonth < 0){ prevMonth = 11; prevYear -= 1; }
    document.getElementById("prevBtn").disabled = isBeforeStart(prevYear, prevMonth);

    var firstOfMonth = new Date(view.year, view.month, 1);
    var lastOfMonth = new Date(view.year, view.month + 1, 0);
    var startOffset = firstOfMonth.getDay(); // 0 = Sunday
    var gridStart = new Date(view.year, view.month, 1 - startOffset);

    var totalCells = startOffset + lastOfMonth.getDate();
    var totalWeeks = Math.ceil(totalCells / 7);

    var container = document.getElementById("weeksContainer");
    container.innerHTML = "";

    var monthGross = 0, monthCountN = 0, monthCountU = 0, monthCountH = 0, monthBonusDays = 0;
    var todayKey = dateKey(now.getFullYear(), now.getMonth(), now.getDate());

    for (var w = 0; w < totalWeeks; w++){
      var weekBlock = document.createElement("div");
      weekBlock.className = "week-block";

      var weekRow = document.createElement("div");
      weekRow.className = "week-row";

      var weekGross = 0;

      for (var d = 0; d < 7; d++){
        var cellDate = new Date(gridStart);
        cellDate.setDate(gridStart.getDate() + w*7 + d);
        var inMonth = cellDate.getMonth() === view.month && cellDate.getFullYear() === view.year;
        var key = dateKey(cellDate.getFullYear(), cellDate.getMonth(), cellDate.getDate());
        var entry = getEntry(key);
        var calc = calcDay(entry);
        weekGross += calc.total;

        if (inMonth){
          monthGross += calc.total;
          monthCountN += entry.n; monthCountU += entry.u; monthCountH += entry.h;
          if (calc.bonus > 0) monthBonusDays++;
        }

        var cell = document.createElement("div");
        cell.className = "day-cell" + (inMonth ? " current-month" : " pad") + (calc.bonus > 0 ? " has-bonus" : "") + (key === todayKey ? " today" : "");
        cell.dataset.key = key;

        var dayNum = document.createElement("div");
        dayNum.className = "day-num";
        dayNum.textContent = cellDate.getDate();
        cell.appendChild(dayNum);

        cell.appendChild(makeField("ปกติ", "n", key, entry.n, inMonth));
        cell.appendChild(makeField("ด่วน", "u", key, entry.u, inMonth));
        cell.appendChild(makeField("ร้อนใจ", "h", key, entry.h, inMonth));

        var totalDiv = document.createElement("div");
        totalDiv.className = "day-total";
        totalDiv.textContent = fmt(calc.total);
        cell.appendChild(totalDiv);

        var bonusNote = document.createElement("div");
        bonusNote.className = "bonus-note";
        bonusNote.textContent = calc.bonus > 0 ? ("🎉 ได้โบนัส +" + calc.bonus + " ฿") : "";
        if (calc.bonus === 0) bonusNote.style.display = "none";
        cell.appendChild(bonusNote);

        weekRow.appendChild(cell);
      }

      weekBlock.appendChild(weekRow);

      var weekSummary = document.createElement("div");
      weekSummary.className = "week-summary";
      weekSummary.innerHTML = "รวมสัปดาห์: <b>" + fmt(weekGross) + "</b> &nbsp;→&nbsp; หลังหักภาษี 3%: <b class='net'>" + fmt(weekGross * TAX_RATE) + "</b>";
      weekBlock.appendChild(weekSummary);

      container.appendChild(weekBlock);
    }

    document.getElementById("sumGross").textContent = fmt(monthGross);
    document.getElementById("sumNet").textContent = fmt(monthGross * TAX_RATE);
    document.getElementById("sumCount").textContent = (monthCountN + monthCountU + monthCountH).toLocaleString('th-TH') +
      "  (" + monthCountN + " / " + monthCountU + " / " + monthCountH + ")";
    document.getElementById("sumBonus").textContent = monthBonusDays + " วัน";
  }

  // Lightweight update after a single field edit — avoids rebuilding the whole
  // calendar (and stealing focus from the input the person is typing in).
  function updateCellAndSummaries(key){
    var cell = document.querySelector('.day-cell[data-key="' + key + '"]');
    if (!cell) return;

    var entry = getEntry(key);
    var calc = calcDay(entry);

    cell.querySelector(".day-total").textContent = fmt(calc.total);
    var bonusNote = cell.querySelector(".bonus-note");
    if (calc.bonus > 0){
      bonusNote.textContent = "🎉 ได้โบนัส +" + calc.bonus + " ฿";
      bonusNote.style.display = "";
      cell.classList.add("has-bonus");
    } else {
      bonusNote.textContent = "";
      bonusNote.style.display = "none";
      cell.classList.remove("has-bonus");
    }

    var weekBlock = cell.closest(".week-block");
    var weekGross = 0;
    weekBlock.querySelectorAll(".day-cell").forEach(function(c){
      weekGross += calcDay(getEntry(c.dataset.key)).total;
    });
    weekBlock.querySelector(".week-summary").innerHTML =
      "รวมสัปดาห์: <b>" + fmt(weekGross) + "</b> &nbsp;→&nbsp; หลังหักภาษี 3%: <b class='net'>" + fmt(weekGross * TAX_RATE) + "</b>";

    var monthGross = 0, monthCountN = 0, monthCountU = 0, monthCountH = 0, monthBonusDays = 0;
    document.querySelectorAll(".day-cell.current-month").forEach(function(c){
      var e = getEntry(c.dataset.key);
      var cc = calcDay(e);
      monthGross += cc.total;
      monthCountN += e.n; monthCountU += e.u; monthCountH += e.h;
      if (cc.bonus > 0) monthBonusDays++;
    });

    document.getElementById("sumGross").textContent = fmt(monthGross);
    document.getElementById("sumNet").textContent = fmt(monthGross * TAX_RATE);
    document.getElementById("sumCount").textContent = (monthCountN + monthCountU + monthCountH).toLocaleString('th-TH') +
      "  (" + monthCountN + " / " + monthCountU + " / " + monthCountH + ")";
    document.getElementById("sumBonus").textContent = monthBonusDays + " วัน";
  }

  function makeField(labelText, fieldKey, dateKeyStr, value, editable){
    var wrap = document.createElement("div");
    wrap.className = "field";

    var label = document.createElement("label");
    label.textContent = labelText;
    wrap.appendChild(label);

    var input = document.createElement("input");
    input.type = "text";
    input.inputMode = "numeric";
    input.pattern = "[0-9]*";
    input.autocomplete = "off";
    input.value = value || "";
    input.placeholder = "0";
    if (!editable) input.disabled = true;

    input.addEventListener("input", function(){
      // strip anything that isn't a digit, keep typing frictionless
      var digitsOnly = input.value.replace(/[^0-9]/g, "");
      if (digitsOnly !== input.value) input.value = digitsOnly;

      var v = parseInt(digitsOnly, 10);
      if (isNaN(v) || v < 0) v = 0;
      var entry = data[dateKeyStr];
      if (!entry){
        entry = { n:0, u:0, h:0 };
        data[dateKeyStr] = entry;
      }
      entry[fieldKey] = v;
      saveData();
      updateCellAndSummaries(dateKeyStr);
    });

    wrap.appendChild(input);
    return wrap;
  }

  document.getElementById("prevBtn").addEventListener("click", function(){
    view.month -= 1;
    if (view.month < 0){ view.month = 11; view.year -= 1; }
    render();
  });

  document.getElementById("nextBtn").addEventListener("click", function(){
    view.month += 1;
    if (view.month > 11){ view.month = 0; view.year += 1; }
    render();
  });

  document.getElementById("todayBtn").addEventListener("click", function(){
    if (isBeforeStart(now.getFullYear(), now.getMonth())){
      view.year = START_YEAR; view.month = START_MONTH;
    } else {
      view.year = now.getFullYear(); view.month = now.getMonth();
    }
    render();
  });

  document.getElementById("exportBtn").addEventListener("click", function(){
    var blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    var stamp = new Date().toISOString().slice(0,10);
    a.href = url;
    a.download = "duang-diary-backup-" + stamp + ".json";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  document.getElementById("importBtn").addEventListener("click", function(){
    document.getElementById("importFile").click();
  });

  document.getElementById("importFile").addEventListener("change", function(e){
    var file = e.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(evt){
      try{
        var imported = JSON.parse(evt.target.result);
        if (typeof imported !== "object" || imported === null) throw new Error("invalid");
        if (confirm("นำเข้าข้อมูลนี้จะรวมกับข้อมูลเดิม (ทับวันที่ซ้ำกัน) ต้องการดำเนินการต่อหรือไม่?")){
          for (var k in imported){
            if (Object.prototype.hasOwnProperty.call(imported, k)){
              data[k] = imported[k];
            }
          }
          saveData();
          render();
          alert("นำเข้าข้อมูลเรียบร้อยแล้ว");
        }
      }catch(err){
        alert("ไฟล์ไม่ถูกต้อง กรุณาเลือกไฟล์ JSON ที่ส่งออกจากระบบนี้");
      }
      document.getElementById("importFile").value = "";
    };
    reader.readAsText(file);
  });

  document.getElementById("clearBtn").addEventListener("click", function(){
    if (confirm("ต้องการล้างข้อมูลทั้งหมดหรือไม่? แนะนำให้ส่งออกข้อมูลสำรองไว้ก่อน การกระทำนี้ไม่สามารถย้อนกลับได้")){
      if (confirm("ยืนยันอีกครั้ง: ล้างข้อมูลทั้งหมดจริงหรือไม่?")){
        data = {};
        saveData();
        render();
      }
    }
  });

  render();
})();
</script>

</body>
</html>
